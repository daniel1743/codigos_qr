VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://tu-dominio.vercel.app
# Internal Onboarding V2 QA surface. Defaults to disabled; set exactly "true"
# only in an explicitly authorized QA environment.
VITE_ENABLE_ONBOARDING_V2=false

# Analytics V1.1 canonical writer production feature gate.
# Defaults to disabled. Canonical production tracking is enabled ONLY when
# VITE_ANALYTICS_CANONICAL_ENABLED is exactly "true" AND the page's public_id
# is listed in VITE_ANALYTICS_CANONICAL_PAGE_ALLOWLIST (comma-separated).
# Leave both empty/unset in production until a controlled canary is authorized.
VITE_ANALYTICS_CANONICAL_ENABLED=false
VITE_ANALYTICS_CANONICAL_PAGE_ALLOWLIST=

# ── Landing bot (asistente IA) ───────────────────────────────────────────────
# Server-side only (NO llevan VITE_): claves del proveedor de IA que usa la
# server function del asistente. DEEPSEEK_* es el primario; FALLBACK_* el
# alternativo. Sin una de las dos el bot responde "No pude responder ahora".
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://oneprovider.dev/api/v1
FALLBACK_MODEL=qwen3.8-flash

# Solo desarrollo: permite chatear con el bot DENTRO del editor (vista previa
# en vivo). Se ignora por completo en builds de producción.
VITE_LANDING_BOT_LIVE_PREVIEW=false
