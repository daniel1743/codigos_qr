VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://tu-dominio.vercel.app
# Internal Onboarding V2 QA surface. Defaults to disabled; set exactly "true"
# only in an explicitly authorized QA environment.
VITE_ENABLE_ONBOARDING_V2=false

# Analytics V1.1 canonical writer production feature gate.
# Production is fail-closed. Canonical tracking is enabled ONLY when
# VITE_ANALYTICS_CANONICAL_ENABLED is exactly "true" AND either:
#   - the page's public_id is listed in VITE_ANALYTICS_CANONICAL_PAGE_ALLOWLIST
#     (comma-separated), or
#   - VITE_ANALYTICS_CANONICAL_GLOBAL_ENABLED is exactly "true" as an explicit,
#     independently authorized global rollout.
# Missing, empty, whitespace-only or malformed allowlists are OFF. "*" is not a
# wildcard. Leave these disabled until a controlled canary is authorized.
VITE_ANALYTICS_CANONICAL_ENABLED=false
VITE_ANALYTICS_CANONICAL_PAGE_ALLOWLIST=
VITE_ANALYTICS_CANONICAL_GLOBAL_ENABLED=false

# ── Landing bot (asistente IA) ───────────────────────────────────────────────
# Server-side only (NO llevan VITE_): claves del proveedor de IA que usa la
# server function del asistente. DEEPSEEK_* es el primario; FALLBACK_* el
# alternativo. Sin una de las dos el bot responde "No pude responder ahora".
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://oneprovider.dev/api/v1
FALLBACK_MODEL=qwen3.8-flash

# Solo desarrollo: permite chatear con el bot DENTRO del editor (vista previa
# en vivo). Se ignora por completo en builds de producción.
VITE_LANDING_BOT_LIVE_PREVIEW=false

# ── Resolución canónica de entradas públicas (FASE 3A/3C) ────────────────────
# SERVER-ONLY (sin VITE_ → nunca se inlinean en el bundle cliente; el gate vive
# detrás de un createServerFn: la allowlist y la evaluación nunca llegan al
# navegador). OFF por defecto. Con el flag en false, /{slug} y /p/{profile_public_id}
# se comportan EXACTAMENTE como hoy (mismo comportamiento, sin consultas extra).
# Activación canaria: flag en "true" + allowlist de public_id/slug (coma). Ejemplo:
#   CANONICAL_PUBLIC_RESOLUTION_ALLOWLIST=VvUsngW,vida-saludable-bienestar
CANONICAL_PUBLIC_RESOLUTION_ENABLED=false
CANONICAL_PUBLIC_RESOLUTION_ALLOWLIST=
